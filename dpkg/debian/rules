#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+bindnow

ifneq ($(DEB_TARGET_ARCH_OS),linux)
SKIP_FUSE2FS=yes
SKIP_SELINUX=yes
SKIP_FANOTIFY=yes
SKIP_LIBNL3=yes
SKIP_UBLK=yes
endif

ifneq ($(filter pkg.erofs-utils.no-erofsfuse,$(DEB_BUILD_PROFILES)),)
SKIP_FUSE2FS=yes
endif

COMMON_CONF_FLAGS = --enable-lzma --enable-multithreading \
	--enable-oci --enable-s3 \
	--with-uuid --with-zlib --with-libdeflate --with-libzstd \
	--with-xxhash ${EXTRA_CONF_FLAGS}

ifneq ($(SKIP_FUSE2FS),)
COMMON_CONF_FLAGS +=  --disable-fuse
else
COMMON_CONF_FLAGS +=  --enable-fuse
endif

ifneq ($(SKIP_SELINUX),)
COMMON_CONF_FLAGS +=  --without-selinux
else
COMMON_CONF_FLAGS +=  --with-selinux
endif

ifneq ($(SKIP_FANOTIFY),)
COMMON_CONF_FLAGS +=  --disable-fanotify
else
COMMON_CONF_FLAGS +=  --enable-fanotify
endif

ifneq ($(SKIP_LIBNL3),)
COMMON_CONF_FLAGS +=  --without-libnl3
else
COMMON_CONF_FLAGS +=  --with-libnl3
endif

ifneq ($(SKIP_UBLK),)
COMMON_CONF_FLAGS +=  --disable-ublk
else
COMMON_CONF_FLAGS +=  --enable-ublk
endif

%:
	dh $@ --with autoreconf

override_dh_auto_configure:
	dh_auto_configure -- \
		--libdir=/usr/lib/$(DEB_HOST_MULTIARCH) \
		--with-root-libdir=/lib/$(DEB_HOST_MULTIARCH) \
		${COMMON_CONF_FLAGS}

override_dh_auto_install:
	find $(CURDIR) -name "*.la" -delete
	dh_auto_install --
